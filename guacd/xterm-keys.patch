+/**
+ * Captivo: sends a key that is not text as xterm does, or returns 1 when the
+ * key is not one of those. Modifiers go as xterm's parameter (1 + Shift 1 +
+ * Alt 2 + Ctrl 4), never as a leading ESC.
+ */
+static int __guac_terminal_send_xterm_key(guac_terminal* term, int keysym) {
+
+    int mods = 1 + (term->mod_shift ? 1 : 0) + (term->mod_alt ? 2 : 0) + (term->mod_ctrl ? 4 : 0);
+    char seq[16];
+    char final = 0;
+    int tilde = 0;
+
+    switch (keysym) {
+        case 0xFF51: case 0xFF96: final = 'D'; break; /* Left */
+        case 0xFF52: case 0xFF97: final = 'A'; break; /* Up */
+        case 0xFF53: case 0xFF98: final = 'C'; break; /* Right */
+        case 0xFF54: case 0xFF99: final = 'B'; break; /* Down */
+        case 0xFF50: case 0xFF95: final = 'H'; break; /* Home */
+        case 0xFF57: case 0xFF9C: final = 'F'; break; /* End */
+        case 0xFFBE: case 0xFF91: final = 'P'; break; /* F1 */
+        case 0xFFBF: case 0xFF92: final = 'Q'; break; /* F2 */
+        case 0xFFC0: case 0xFF93: final = 'R'; break; /* F3 */
+        case 0xFFC1: case 0xFF94: final = 'S'; break; /* F4 */
+        case 0xFF63: case 0xFF9E: tilde = 2; break;   /* Insert */
+        case 0xFFFF: case 0xFF9F: tilde = 3; break;   /* Delete */
+        case 0xFF55: case 0xFF9A: tilde = 5; break;   /* Page up */
+        case 0xFF56: case 0xFF9B: tilde = 6; break;   /* Page down */
+        case 0xFFC2: tilde = 15; break;               /* F5 */
+        case 0xFFC3: tilde = 17; break;               /* F6 */
+        case 0xFFC4: tilde = 18; break;               /* F7 */
+        case 0xFFC5: tilde = 19; break;               /* F8 */
+        case 0xFFC6: tilde = 20; break;               /* F9 */
+        case 0xFFC7: tilde = 21; break;               /* F10 */
+        case 0xFFC8: tilde = 23; break;               /* F11 */
+        case 0xFFC9: tilde = 24; break;               /* F12 */
+        case 0xFF09: case 0xFF89:                     /* Shift+Tab */
+            if (!term->mod_shift)
+                return 1;
+            return guac_terminal_send_string(term, "\x1B[Z");
+        default:
+            return 1;
+    }
+
+    if (tilde) {
+        if (mods > 1)
+            snprintf(seq, sizeof(seq), "\x1B[%d;%d~", tilde, mods);
+        else
+            snprintf(seq, sizeof(seq), "\x1B[%d~", tilde);
+    }
+    else if (mods > 1)
+        snprintf(seq, sizeof(seq), "\x1B[1;%d%c", mods, final);
+    else if (final >= 'P' || term->application_cursor_keys)
+        snprintf(seq, sizeof(seq), "\x1BO%c", final);
+    else
+        snprintf(seq, sizeof(seq), "\x1B[%c", final);
+
+    return guac_terminal_send_string(term, seq);
+
+}
