+/**
+ * Captivo: tells the connection's users that a full-screen program (vim, top,
+ * less) took the terminal's alternate buffer, or gave it back. Captivo's data
+ * plane leaves what is typed into one out of the keystroke log, and removes
+ * the instruction before the browser; guacamole-common-js ignores it anyway.
+ */
+static void captivo_alt_screen(guac_terminal* term, int on) {
+    guac_socket* socket = term->client->socket;
+    guac_socket_instruction_begin(socket);
+    guac_socket_write_string(socket, on ? "17.captivo-altscreen,1.1;" : "17.captivo-altscreen,1.0;");
+    guac_socket_instruction_end(socket);
+    guac_socket_flush(socket);
+}
