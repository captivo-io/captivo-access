+/**
+ * Sends the clipboard to the terminal's input as a terminal emulator pastes:
+ * line breaks become CR, as the Enter key sends, and the text is bracketed by
+ * ESC [ 200 ~ / ESC [ 201 ~ when the application asked for that (mode 2004).
+ * Sent raw, each LF arrived as Ctrl+J, which nano runs as Justify, merging the
+ * lines of a pasted certificate into one paragraph. Within a bracketed paste
+ * ESC is dropped, so the text cannot end the bracket early and run as input.
+ *
+ * @param term
+ *     The terminal to paste into.
+ *
+ * @return
+ *     Zero if the clipboard was sent successfully, non-zero otherwise.
+ */
+static int guac_terminal_paste(guac_terminal* term) {
+
+    /* Block all other sources of input if input is coming from a stream */
+    if (term->input_stream != NULL)
+        return 0;
+
+    const char* data = term->clipboard->buffer;
+    int length = term->clipboard->length;
+    bool bracketed = term->bracketed_paste;
+
+    char output[4096];
+    int used = 0;
+
+    if (bracketed) {
+        memcpy(output, "\x1B[200~", 6);
+        used = 6;
+    }
+
+    for (int i = 0; i < length; i++) {
+
+        char c = data[i];
+
+        /* CR LF and lone LF both become one CR */
+        if (c == '\n') {
+            if (i > 0 && data[i - 1] == '\r')
+                continue;
+            c = '\r';
+        }
+        else if (c == 0x1B && bracketed)
+            continue;
+
+        if (used == sizeof(output)) {
+            if (guac_terminal_write_all(term->stdin_pipe_fd[1], output, used) < 0)
+                return 1;
+            used = 0;
+        }
+        output[used++] = c;
+
+    }
+
+    if (used > 0 && guac_terminal_write_all(term->stdin_pipe_fd[1], output, used) < 0)
+        return 1;
+
+    if (bracketed && guac_terminal_write_all(term->stdin_pipe_fd[1], "\x1B[201~", 6) < 0)
+        return 1;
+
+    return 0;
+
+}
