# Captivo Access — PRODUCTION environment template.
# Copy to .env next to docker-compose.prod.yml, fill in real values, never commit it.
#
#   cp .env.prod.example .env

# The base domain this deployment is served under. Caddy routes
# manager.<ACCESS_DOMAIN> to the Manager console, connect.<ACCESS_DOMAIN> to
# the connector WSS tunnel, and *.<ACCESS_DOMAIN> to per-site vendor access.
# Point DNS for all three at this host before starting.
ACCESS_DOMAIN=access.example.com

# Cross-subdomain SSO cookie domain — a leading-dot domain covering both the
# Manager and every vendor site subdomain, so the session cookie set at
# manager.<ACCESS_DOMAIN> is also readable at <site>.<ACCESS_DOMAIN>.
COOKIE_DOMAIN=.access.example.com

# The Manager's own public URL (used to build absolute login redirects, e.g.
# from the data-plane's proxy back to /login?returnTo=...).
MANAGER_PUBLIC_URL=https://manager.access.example.com

# WebAuthn Relying Party ID. Must be a domain the browser's origin is under —
# use the bare ACCESS_DOMAIN (not the manager.* subdomain) so passkeys are
# valid across the whole domain, matching COOKIE_DOMAIN's scope. This MUST
# match the host the browser actually uses to reach the Manager, or passkey
# registration/login will fail.
WEBAUTHN_RP_ID=access.example.com

# PostgreSQL password (used by both access-postgres and the Manager's
# DATABASE_URL — docker-compose.prod.yml wires them together automatically).
# openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME

# Session signing secret.
# openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# TOTP recovery-secret encryption key (AES-256-GCM).
# openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME

# Shared secret between the Manager and the data-plane's internal API.
# openssl rand -hex 32
DATAPLANE_SECRET=CHANGE_ME

# Bearer secret that authorizes the cron endpoints (e.g.
# POST /api/cron/audit-retention). Required in production — the endpoints
# fail closed without it.
# openssl rand -hex 32
CRON_SECRET=CHANGE_ME

# How long AuditEvent rows are kept (days) before the audit-retention cron
# deletes them. Set per your legal counsel — KVKK/5651 retention obligations.
AUDIT_RETENTION_DAYS=730

# Optional overrides (sane defaults baked into docker-compose.prod.yml):
# INVITE_TTL_HOURS=48
# SESSION_TTL_HOURS=12
# AUDIT_QUEUE_CAP=10000
# Optional: POST a JSON alert to this URL whenever a Site goes down or recovers
# (best-effort; works with Slack/Teams incoming webhooks via the "text" field,
# or any custom endpoint via the structured fields).
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/...
# CONNECTOR_TUNNEL_URL: the WSS endpoint the generated connector install command
# points at. Defaults to wss://connect.<ACCESS_DOMAIN>; set only if your connect
# host differs from the manager./connect. convention.
# CONNECTOR_TUNNEL_URL=wss://connect.access.example.com

# Optional: single wildcard cert across *.<ACCESS_DOMAIN> via ACME DNS-01. Not
# needed by default — stock Caddy issues a per-app cert automatically via
# On-Demand TLS. Only needed when you bring up the stack with
# docker-compose.dns.override.yml (which builds a custom Caddy image with a DNS
# plugin) and switch the wildcard block in Caddyfile from `tls { on_demand }` to
# `tls { dns ... }`. See deploy/README.md "Wildcard TLS".
#
# DNS_API_TOKEN: your DNS provider's API token (Cloudflare "Edit zone DNS"
# scoped token, deSEC token, etc.). Keep it secret — never commit .env.
DNS_API_TOKEN=
# CADDY_DNS_MODULE: the caddy-dns module for your provider. Defaults to
# Cloudflare; set it for anything else (e.g. github.com/caddy-dns/desec).
# CADDY_DNS_MODULE=github.com/caddy-dns/cloudflare

# Session recording (Pro) — ON by default. Uncomment to disable (the per-Site
# "Record sessions" toggle drives web-session rrweb recording when on).
# RECORDING_ENABLED=0

# Native remote-desktop gateway (RDP/SSH/VNC) — ON by default. Uncomment to disable
# (hides the "Remote session" Resource type). The connector already bundles guacd.
# Remote-session logins also need the credential vault (on by default below).
# NATIVE_GATEWAY=0

# Isolated browser (RBI) — ON by default. Uncomment to disable (hides the "Isolated
# browser" Resource type). The connector already bundles KasmVNC.
# ISOLATED_ENABLED=0

# Credential vault — ON by default. Uncomment to disable (stores per-Resource
# RDP/SSH/VNC credentials, injected server-side, never shown to the vendor).
# Required for remote-session logins.
# VAULT_ENABLED=0

# Image version to run. The compose file pins the published ghcr.io images to
# a specific release by default (reproducible installs). Uncomment to override
# the version, or set to a newer release when upgrading (then `up -d`).
# CAPTIVO_VERSION=1.9.0

# --- Session recordings -------------------------------------------------------
# Recordings (screen, keystrokes, isolated-browser video) are stored ON THIS HOST by
# the connector, encrypted with a key the connector generates. The control plane never
# receives the content and cannot read it.
#
# What that means for you:
#   * BACK UP the connector's volume. Nobody else has a copy -- not us. Losing the
#     volume loses the recordings permanently.
#   * BACK UP /data/recording.key WITH IT. The recordings are useless without it, and
#     it cannot be recovered or reissued.
#   * A recording is searchable and playable only while its connector is online.
#   * An erasure requested in the console completes when the connector next connects.
#
# RECORDING_DIR=/data/recordings
# RECORDING_KEY_FILE=/data/recording.key
