// Captivo Access — Manager database schema.
// Tenant-aware. Every table carries tenantId (FK → Tenant). Uniques are
// tenant-scoped (composite) and singletons are keyed per tenant. Self-host runs
// as the single seeded "default" tenant (MULTI_TENANT off). RLS enforcement is
// applied out-of-band by the RLS bootstrap (prisma/rls/bootstrap.sql).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A tenant (organization). Self-host uses the single seeded row id="default".
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt DateTime @default(now())
  // --- Platform console (Cloud) ---
  plan         String    @default("free") // free | pro | enterprise
  // Default "free" on purpose: an unclassified tenant should not be labelled as
  // something someone paid for. The plan is a LABEL here -- caps live in
  // `limits` -- so this restricts nothing on its own.
  trialEndsAt  DateTime? // plan=trial: auto-suspended by the platform-ops cron after this
  deletedAt    DateTime? // soft-deleted (hidden from resolvers); purged 30 days later
  limits       Json? // { maxUsers?, maxSites?, maxConnectors?, maxRecordingRetentionDays? } — null/absent = unlimited
  capabilities Json? // { recording?, isolated?, gateway?, vault? } booleans — absent = deployment default
  notes        String? // internal operator notes (never shown to the tenant)
  /// The Captivo ID organisation this workspace was provisioned for. Unique so
  /// one organisation can never hold two free-tier workspaces; null on every
  /// tenant an operator created by hand.
  captivoOrgId String?   @unique
  updatedAt    DateTime  @default(now()) @updatedAt
  supportHandoffs SupportHandoff[]

  users             User[]
  passkeys          Passkey[]
  totpSecrets       TotpSecret[]
  invites           Invite[]
  sessions          Session[]
  connectors        Connector[]
  connectorPairings ConnectorPairing[]
  sites             Site[]
  vaultCredentials  VaultCredential[]
  accessGrants      AccessGrant[]
  auditEvents       AuditEvent[]
  auditChainStates  AuditChainState[]
  auditAnchors      AuditAnchor[]
  adminAuditAnchors AdminAuditAnchor[]
  smtpConfigs       SmtpConfig[]
  brandingConfigs   BrandingConfig[]
  notifications     Notification[]
  oidcConfigs       OidcConfig[]
  directoryConfigs  DirectoryConfig[]
  groupMappings     GroupMapping[]
  sessionPolicies   SessionPolicy[]
  cronRuns          CronRun[]
  platformSettings  PlatformSettings[]
  updateCheckConfigs UpdateCheckConfig[]
  sessionRecordings SessionRecording[]
  recordingChunks   RecordingChunk[]
  sessionKeyEvents  SessionKeyEvent[]
  adminAuditEvents  AdminAuditEvent[]
}

enum Role {
  ADMIN
  OPERATOR
  AUDITOR
  STAFF
  VENDOR
  PLATFORM
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id             String        @id @default(cuid())
  tenantId       String        @default("default")
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String
  name           String
  phone          String?
  company        String?
  timezone       String? // per-user display timezone override (IANA); null = inherit
  role           Role
  status         UserStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now())
  passkeys       Passkey[]
  totp           TotpSecret?
  sessions       Session[]
  invitesCreated Invite[]      @relation("InviteCreator")
  grantsSubject  AccessGrant[] @relation("GrantSubject")
  grantsApproved AccessGrant[] @relation("GrantApprover")
  grantsCreated  AccessGrant[] @relation("GrantCreator")

  directoryManaged        Boolean   @default(false)
  directoryLastVerifiedAt DateTime?

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Passkey {
  id           String    @id @default(cuid())
  tenantId     String    @default("default")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    // base64url
  publicKey    Bytes // COSE public key (not sensitive — public)
  counter      BigInt    @default(0)
  transports   String[] // usb/nfc/ble/internal/hybrid
  label        String // "iPhone", "Laptop" — user-facing label
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@unique([tenantId, credentialId])
  @@index([userId])
  @@index([tenantId])
}

model TotpSecret {
  userId      String    @id // 1:1
  tenantId    String    @default("default")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String // AES-256-GCM encrypted (crypto.ts)
  confirmedAt DateTime? // set once enrollment is verified

  @@index([tenantId])
}

model Invite {
  id          String    @id @default(cuid())
  tenantId    String    @default("default")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  name        String
  phone       String?
  company     String?
  role        Role
  tokenHash   String    // argon2(random 32B); plaintext only in the link
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([tenantId, tokenHash])
  @@index([email])
  @@index([tenantId])
}

model Session {
  id         String   @id @default(cuid())
  tenantId   String   @default("default")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   // sha256(opaque random); plaintext token lives in the cookie
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  @@unique([tenantId, tokenHash])
  @@index([userId])
  @@index([tenantId])
}

enum ConnectorStatus {
  PENDING
  ONLINE
  OFFLINE
  REVOKED
}

enum SiteAccessMode {
  TRANSPARENT
  GATEWAY
  ISOLATED
}

model Connector {
  id         String          @id @default(cuid())
  tenantId   String          @default("default")
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String
  status     ConnectorStatus @default(PENDING)
  lastSeenAt DateTime?
  version    String?
  remoteAddr String?
  egressPolicy String?
  logLevel   String?         // debug | info | warn | error; null = inherit the policy default — pushed to the connector live
  createdAt  DateTime        @default(now())
  sites      Site[]
  pairings   ConnectorPairing[]
  directoryConfigs DirectoryConfig[]

  @@unique([tenantId, tokenHash])
  @@index([tenantId])
}

model ConnectorPairing {
  id          String     @id @default(cuid())
  tenantId    String     @default("default")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codeHash    String
  name        String
  connectorId String?
  connector   Connector? @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([tenantId])
}

model Site {
  id                 String        @id @default(cuid())
  tenantId           String        @default("default")
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectorId        String
  connector          Connector     @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  name               String
  hostname           String?       // null for GATEWAY (remote-desktop) sites; required for web apps
  customDomain       Boolean       @default(false) // hostname is a tenant-owned FQDN (BYO), not a managed <label>.<slug> host
  domainVerifiedAt   DateTime?     // set when the custom domain's DNS is verified to point at this server
  upstreamUrl        String?
  insecureSkipVerify Boolean       @default(false)
  description        String?
  probedAt           DateTime?
  probeOk            Boolean?
  probeDetail        String?
  probeLatencyMs     Int?
  recordSessions     Boolean       @default(false)
  keystrokeLogging   Boolean       @default(false) // GATEWAY: capture typed input into a keystroke timeline
  clipboardMode      String?       // null = inherit PlatformSettings.clipboardDefault; else allow | no_copy | no_paste | none (web via proxy; gateway via guacd disable-copy/disable-paste)
  watermark          Boolean?      // isolated DLP watermark; null = inherit the global watermarkDefault
  fileTransferMode   String        @default("none") // allow | no_upload | no_download | none (ISOLATED only)
  accessMode         SiteAccessMode @default(TRANSPARENT)
  logo               Bytes?
  logoType           String?
  createdAt          DateTime      @default(now())
  grants             AccessGrant[]
  groupMappings      GroupMapping[]
  vaultCredential    VaultCredential?

  @@unique([tenantId, hostname])
  @@index([tenantId])
}

enum VaultProtocol {
  RDP
  SSH
  VNC
}

enum VaultSecretKind {
  PASSWORD
  KEY
}

// VaultCredential holds a GATEWAY site's target credentials, encrypted at rest,
// injected into the Guacamole session so the vendor never sees the password.
model VaultCredential {
  id         String          @id @default(cuid())
  tenantId   String          @default("default")
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId     String          @unique // 1:1 with Site; a site is in one tenant, so globally unique is safe
  site       Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  protocol   VaultProtocol
  targetHost String
  targetPort Int
  username   String
  secret     String // AES-256-GCM ciphertext (password OR private key)
  secretKind VaultSecretKind @default(PASSWORD)
  guacParams Json? // curated per-resource Guacamole connection params (validated allowlist)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([tenantId])
}

enum GrantStatus {
  ACTIVE
  REVOKED
  DENIED
}

model AccessGrant {
  id       String      @id @default(cuid())
  tenantId String      @default("default")
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation("GrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  siteId   String
  site     Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  startsAt DateTime?
  endsAt   DateTime?
  status   GrantStatus @default(ACTIVE)
  note     String?
  denyReason String?

  requiresApproval Boolean   @default(false)
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?     @relation("GrantApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  schedule Json?

  createdById String?
  createdBy   User?    @relation("GrantCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  directoryManaged Boolean @default(false)

  @@index([userId, siteId])
  @@index([tenantId])
}

enum AuditDecision {
  ALLOW
  DENY
}

model AuditEvent {
  id        String        @id @default(cuid())
  tenantId  String        @default("default")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timestamp DateTime      @default(now())
  userId    String?
  userEmail String?
  userName  String?
  company   String?
  siteId    String?
  siteName  String?
  host      String
  method    String
  path      String
  status    Int
  bytesOut  BigInt        @default(0)
  decision  AuditDecision
  reason    String?
  clientIp  String?
  userAgent String?
  seq       BigInt
  prevHash  String        @default("")
  hash      String        @default("")
  createdAt DateTime      @default(now())

  @@unique([tenantId, seq])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([siteId, timestamp])
  @@index([seq])
  @@index([tenantId])
}

// Per-tenant, per-scope tamper-evidence chain head (scope: "access" | "admin").
model AuditChainState {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope     String   // "access" | "admin"
  lastSeq   BigInt   @default(0)
  lastHash  String   @default("")
  updatedAt DateTime @updatedAt

  @@id([tenantId, scope])
}

// AuditAnchor stores one RFC 3161 timestamp per successful external anchor of
// the audit chain head. Each row is a verifiable proof that the head was
// (anchoredSeq, anchoredHash) at the TSA's genTime — pinning history against a
// later full-DB rewrite. Only successful anchors are stored.
model AuditAnchor {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anchoredSeq  BigInt
  anchoredHash String
  tsaUrl       String
  token        Bytes
  genTime      DateTime
  createdAt    DateTime @default(now())

  @@index([anchoredSeq])
  @@index([createdAt])
  @@index([tenantId])
}

// AdminAuditAnchor mirrors AuditAnchor for the admin-audit chain (head stored in
// AuditChainState under scope = "admin"). Kept a separate table so the working,
// externally-notarized access anchor path stays untouched.
model AdminAuditAnchor {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anchoredSeq  BigInt
  anchoredHash String
  tsaUrl       String
  token        Bytes
  genTime      DateTime
  createdAt    DateTime @default(now())

  @@index([anchoredSeq])
  @@index([createdAt])
  @@index([tenantId])
}

// Per-tenant outbound SMTP relay configuration (one row per tenant).
model SmtpConfig {
  tenantId  String   @id @default("default")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host      String
  port      Int
  secure    Boolean  @default(false)
  username  String
  password  String
  fromName  String
  fromEmail String
  enabled            Boolean  @default(false)
  lastVerifiedAt     DateTime?
  lastVerifiedOk     Boolean?
  lastVerifiedDetail String?
  updatedAt DateTime @updatedAt
}

model BrandingConfig {
  tenantId        String   @id @default("default")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  splashImage     Bytes?
  splashImageType String? // MIME of splashImage
  updatedAt       DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String    @default("default")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String // "site_down" | "site_recovered"
  siteId    String?
  siteName  String
  detail    String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([readAt])
  @@index([createdAt])
  @@index([tenantId])
}

// Per-tenant OIDC SSO configuration (one row per tenant).
model OidcConfig {
  tenantId     String   @id @default("default")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled      Boolean  @default(false)
  issuer       String
  clientId     String
  clientSecret String                  // encrypted at rest (lib/crypto)
  buttonLabel        String?
  lastVerifiedAt     DateTime?
  lastVerifiedOk     Boolean?
  lastVerifiedDetail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Per-tenant LDAP/AD directory configuration (one row per tenant).
model DirectoryConfig {
  tenantId           String    @id @default("default")
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled            Boolean   @default(false)
  connectorId        String?
  connector          Connector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  host               String    @default("")
  port               Int       @default(389)
  security           String    @default("STARTTLS") // PLAIN | STARTTLS | LDAPS
  insecureSkipVerify Boolean   @default(false)
  caCertPem          String    @default("") // PEM CA(s) to verify LDAPS/StartTLS against; "" = system roots
  baseDN             String    @default("")
  bindDN             String    @default("")
  bindPassword       String    @default("") // encrypted at rest (lib/crypto)
  lastTestedAt       DateTime?
  lastTestOk         Boolean?
  lastTestDetail     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([connectorId])
}

model GroupMapping {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupDN   String   // full DN, e.g. "CN=Captivo-Admins,OU=Groups,DC=corp,DC=local"
  kind      String   // "ROLE" | "SITE"
  role      Role?    // set when kind = "ROLE": ADMIN | OPERATOR | AUDITOR
  siteId    String?  // set when kind = "SITE"
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupDN])
  @@index([tenantId])
}

// Per-tenant session policy (one row per tenant).
model SessionPolicy {
  tenantId             String   @id @default("default")
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  idleTimeoutMinutes   Int?
  maxSessionHours      Int?
  maxConcurrentPerUser Int?
  updatedAt            DateTime @updatedAt
}

// CronRun records the last time each external cron endpoint was hit, so the
// console can warn when a scheduled job (retention / health) isn't actually
// running — the classic "policy set but nobody scheduled the cron" gap. One row
// per (tenant, job).
model CronRun {
  tenantId String   @default("default")
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job      String
  ranAt    DateTime

  @@id([tenantId, job])
}

// Per-tenant operational settings that were previously env-only. Each field is
// optional; an unset field falls back to its former env var, then a hard
// default, so an existing deployment keeps working and the env var becomes
// optional. One row per tenant.
model PlatformSettings {
  tenantId               String   @id @default("default")
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditRetentionDays     Int? // was AUDIT_RETENTION_DAYS (default 730)
  inviteTtlHours         Int? // was INVITE_TTL_HOURS (default 48)
  notificationWebhookUrl String? // was NOTIFICATION_WEBHOOK_URL
  vendorIpAllowlist      String? // CIDRs/IPs; empty = no restriction. Gates vendor SITE access only.
  maxGrantDays           Int? // cap on a grant's duration; 0/null = no cap (permanent grants allowed)
  recordingConsentRequired Boolean? // was RECORDING_CONSENT_REQUIRED; null = env fallback → false
  watermarkDefault         Boolean? // global isolated-session watermark default; null = env/default → false
  clipboardDefault         String? // global clipboard default for inheriting resources; null = "allow"
  displayTimezone          String? // global display timezone (IANA); null = viewer's browser
  recordingRetentionDays Int? // auto-delete recordings older than N days; 0/null = keep forever
  defaultConnectorLogLevel String? // fleet default log level for connectors set to "use default"; null → info
  externalAnchorEnabled Boolean? // opt-in; null/false = anchoring off
  anchorTsaUrl          String? // RFC 3161 TSA endpoint; empty = unset (no bundled default)
  anchorTsaAuth         String? // optional "user:pass" for a TSA behind HTTP Basic; empty = none
  notifySiteHealth      Boolean? // email admins on site up/down; null = default on
  notifyAccessRequests  Boolean? // email admins on new access requests; null = default on
  notifyAccessDecisions Boolean? // email the vendor on approve/deny; null = default on
  requireRequestJustification Boolean? // require a justification on access requests; null = default on (required)
  keystrokeLoggingMode  String? // tenant-wide keystroke logging: "off" | "per_resource" | "required"; null → per_resource
  recordingMode String? // null = env/default → "per_resource"; one of off|per_resource|required
  guacParamDefaults     Json? // global default Guacamole connection params (validated allowlist)
  updatedAt              DateTime @updatedAt
}

model UpdateCheckConfig {
  tenantId      String    @id @default("default")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(true)
  latestVersion String?
  latestUrl     String?
  lastCheckedAt DateTime?
  lastCheckOk   Boolean?
  updatedAt     DateTime  @updatedAt
}

enum RecordingFormat {
  RRWEB
  GUAC
  VIDEO
}

model SessionRecording {
  id           String           @id @default(cuid())
  tenantId     String           @default("default")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordingKey String
  siteId       String
  userId       String
  host         String
  startedAt    DateTime         @default(now())
  lastEventAt  DateTime         @default(now())
  eventCount   Int              @default(0)
  bytes        Int              @default(0)
  format       RecordingFormat  @default(RRWEB)
  protocol     String?
  encrypted    Boolean          @default(false)
  chunks       RecordingChunk[]

  @@unique([tenantId, recordingKey])
  @@index([siteId])
  @@index([userId])
  @@index([startedAt])
  @@index([tenantId])
}

model RecordingChunk {
  id          String           @id @default(cuid())
  tenantId    String           @default("default")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordingId String
  seq         Int
  data        Bytes
  createdAt   DateTime         @default(now())
  recording   SessionRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId, seq])
  @@index([tenantId])
}

model SessionKeyEvent {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordingKey String   // ties to SessionRecording.recordingKey
  seq          Int
  atMs         Int      // offset from recording start, ms (player seek)
  kind         String   // "command" | "text"
  data         Bytes    // AES-256-GCM(text)
  masked       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([recordingKey, seq])
  @@index([tenantId])
}

model AdminAuditEvent {
  id         String   @id @default(cuid())
  tenantId   String   @default("default")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timestamp  DateTime @default(now())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  summary    String
  metadata   Json?
  clientIp   String?
  createdAt  DateTime @default(now())
  seq        BigInt?
  prevHash   String   @default("")
  hash       String   @default("")

  @@unique([tenantId, seq])
  @@index([timestamp])
  @@index([action, timestamp])
  @@index([targetType, targetId])
  @@index([seq])
  @@index([tenantId])
}

// Platform-wide configuration (Cloud). ONE row (id = "platform"). Deliberately NOT
// tenant-scoped / not under RLS: every tenant request may read it (announcement
// banner, signup toggle, SMTP fallback flag); only platform admins write it
// (app-level authorization).
model PlatformConfig {
  id                String    @id @default("platform")
  announcementText  String?
  announcementLevel String? // info | warn | danger
  announcementUntil DateTime?
  newTenantDefaults Json? // PlatformSettings subset applied to newly created tenants
  opsEmail          String? // platform operations digest recipient
  smtpFallback      Boolean   @default(false) // tenants with no SMTP send via the platform tenant's SMTP
  signupEnabled     Boolean   @default(false) // public /signup on the platform host
  updatedAt         DateTime  @default(now()) @updatedAt
}

// One-time handoff for a platform admin opening a tenant console as support.
// Created INSIDE the target tenant's scope so the tenant-host handoff route can
// read it under RLS; consumed once; short-lived.
model SupportHandoff {
  id         String    @id @default(cuid())
  tenantId   String    @default("default")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenHash  String
  actorId    String
  actorEmail String
  reason     String
  expiresAt  DateTime
  usedAt     DateTime?
  sessionId  String? // the support Session created on handoff (for the in-console banner)
  createdAt  DateTime  @default(now())

  @@unique([tenantId, tokenHash])
  @@index([tenantId])
}
